public class CountDigitsThatDivide {
    public static int countDigitsThatDivide(int num) {
        String numStr = String.valueOf(num);
        int count = 0;
        for (char c : numStr.toCharArray()) {
            int digit = c - '0';
            if (digit != 0 && num % digit == 0) count++;
        }
        return count;
    }

    public static void main(String[] args) {
        int[] testCases = {7, 121, 1248};
        for (int num : testCases) {
            System.out.println("countDigitsThatDivide(" + num + ") = " + countDigitsThatDivide(num));
        }
    }
}
