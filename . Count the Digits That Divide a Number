public class CountDigitsDivideNumber {
    public static int countDigits(int num) {
        int count = 0, temp = num;
        while (temp > 0) {
            int digit = temp % 10;
            if (digit != 0 && num % digit == 0) count++;
            temp /= 10;
        }
        return count;
    }

    public static void main(String[] args) {
        int[] testCases = {7, 121, 1248};
        for (int num : testCases) {
            System.out.println("countDigits(" + num + ") = " + countDigits(num));
        }
    }
}
