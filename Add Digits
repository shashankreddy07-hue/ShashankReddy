public class AddDigits {
    public static int addDigits(int num) {
        while (num >= 10) {
            int sum = 0;
            while (num > 0) {
                sum += num % 10;
                num /= 10;
            }
            num = sum;
        }
        return num;
    }
    public static void main(String[] args) {
        int[] testCases = {38, 0, 123456, 9999};
        for (int num : testCases) {
            System.out.println("addDigits(" + num + ") = " + addDigits(num));
        }
    }
}
