public class NumberOf1Bits {
    public static int hammingWeight(int n) {
        int count = 0;
        for (int i = 0; i < 32; i++) {
            if ((n & (1 << i)) != 0) count++;
        }
        return count;
    }
    public static void main(String[] args) {
        int[] testCases = {11, 128, -3, 0};
        for (int num : testCases) {
            System.out.println("hammingWeight(" + num + ") = " + hammingWeight(num));
        }
    }
}
